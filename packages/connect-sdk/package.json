{
  "name": "@margin-connect/sdk",
  "version": "0.1.0",
  "description": "Fail-closed, finality-aware TypeScript integration SDK for MARGIN V2 Covered Claims.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node build.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:consumer": "node test/consumer-import.mjs && node test/consumer-import.cjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.0.5"
  }
}
