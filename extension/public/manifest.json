{
  "manifest_version": 3,
  "name": "MARGIN",
  "version": "0.1.0",
  "description": "Consensus-backed annotations for narrowly scoped public web claims.",
  "permissions": ["storage", "contextMenus", "sidePanel", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://studio.genlayer.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "side_panel": {"default_path": "sidepanel.html"},
  "options_page": "options.html",
  "action": {"default_title": "Open MARGIN", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}},
  "minimum_chrome_version": "114"
}
